--- !u!114 &853940139
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 853940135}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c1a6e1f8f8f65ec42bc85bec06fdb4da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  howToPlayText: {fileID: 224159188}
  prevButton: {fileID: 104840862}
  nextButton: {fileID: 997660470}
  pages:
  - "7\uC6E8\uC774\uBE0C\uB3D9\uC548 \uBAB0\uB824\uC624\uB294 \uBAAC\uC2A4\uD130\uB4E4\uC744
    \uC8FD\uC774\uACE0 \uAC15\uD574\uC838 \uCD5C\uC885\uBCF4\uC2A4\uAE4C\uC9C0 \uBB34\uCC14\uB7EC\uB77C!"
  - "\uC774\uB3D9: \uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD / \uC90C: \uB9C8\uC6B0\uC2A4
    \uD720, \uB514\uD3F4\uD2B8\uB85C \uBCC0\uACBD: \uD720 \uB354\uBE14 \uD074\uB9AD\n\uADF8\uB798\uD50C\uB9C1
    \uD6C5 \uAC74 \uC0AC\uC6A9: \uC774\uB3D9 \uC911\uC5D0 \uC2A4\uD398\uC774\uC2A4\uBC14\n\n\uC67C\uC190\uC7A1\uC774\uB77C\uBA74,\n[\uB514\uD3F4\uD2B8]
    \uBAA8\uC2A4\uBD80\uD638 \uD0A4: A, \uC5D4\uD130\uD0A4: W \n\uC624\uB978\uC190\uC7A1\uC774\uB77C\uBA74,
    \uD0A4\uC138\uD305\uC744 \uD574\uC8FC\uC138\uC694. \uC624\uB978\uC190\uC7A1\uC774\uAC00
    \uC544\uB2C8\uB77C\uC11C \uBAA8\uB974\uACA0\uB124\n\uC77C\uB2E8\uC740 \uBAA8\uC2A4\uBD80\uD638
    \uD0A4: L, \uC5D4\uD130\uD0A4 I \uCD94\uCC9C \uB4DC\uB9BD\uB2C8\uB2E4."
  - "\uC67C\uCABD\uC5D0 \uBCF4\uC774\uB294 \uB8EC\uC744 \uC791\uC131\uD558\uAE30
    \uC704\uD574 \uBAA8\uC2A4\uBD80\uD638\uD0A4\uB97C \uC785\uB825\uD569\uB2C8\uB2E4.\n\uBAA8\uC2A4\uBD80\uD638\uD0A4\uB97C
    \uC9E7\uAC8C \uB204\uB974\uBA74 \".\" 0.01\uCD08 \uC774\uC0C1 \uB204\uB974\uBA74
    \"\u3161\"\n\uB2E4 \uC791\uC131\uD588\uC73C\uBA74, \uC5D4\uD130\uD0A4 \uB97C
    \uB20C\uB7EC \uB8EC\uC744 \uC644\uC131\uD569\uB2C8\uB2E4.\n\n\uB9C8\uBC95\uC744
    \uC4F0\uAE30 \uC704\uD574 \uD544\uC694\uD55C \uB8EC\uC740 \uCD5C\uB300 3\uAC1C\uAE4C\uC9C0
    \uC788\uC73C\uBA70\n\uBAA8\uB4E0 \uB8EC\uC744 \uB2E4 \uC791\uC131\uD588\uB2E4\uBA74
    \uBAAC\uC2A4\uD130\uB97C \uD5A5\uD574 \uC6B0\uD074\uB9AD\uC744 \uD558\uC5EC \uD574\uB2F9
    \uBC29\uD5A5\uC73C\uB85C\n\uB9C8\uBC95\uC744 \uC2DC\uC804\uD569\uB2C8\uB2E4."
  - "\uB9C8\uBC95\uC758 \uB370\uBBF8\uC9C0\uC640 \uB9C8\uB098 \uC18C\uBAA8\uB294
    \uAC01 \uB8EC\uC758 \uB370\uBBF8\uC9C0, \uB9C8\uB098\uC758 \uCD1D\uD569\uC785\uB2C8\uB2E4.\n\uC6E8\uC774\uBE0C\uAC00
    \uB05D\uB0A0 \uB54C\uB9C8\uB2E4 \uB8EC\uC744 \uAC15\uD654\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB8EC
    \uAC15\uD654 \uC2DC, \uD574\uB2F9 \uB8EC\uC758 \uB370\uBBF8\uC9C0\uAC00 \uC99D\uAC00\uD558\uACE0
    \uB9C8\uB098 \uC18C\uBAA8\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\n\uD55C \uC6E8\uC774\uBE0C
    \uB3D9\uC548 \uBA54\uBAA8\uB77C\uC774\uC988 \uAC00\uB2A5\uD55C \uB9C8\uBC95\uC740
    \uCD5C\uB300 3\uAC1C\uC785\uB2C8\uB2E4.\n\uAC01\uAC01 \uB8EC1\uAC1C(\uB178\uBE44\uC2A4),
    \uB8EC2\uAC1C(\uC5B4\uD504\uB80C\uD2F0\uC2A4), \uB8EC3\uAC1C(\uC5B4\uB381\uD2B8)\uC785\uB2C8\uB2E4."
  - "\uBA54\uBAA8\uB77C\uC774\uC988 \uC911\uC778 \uB9C8\uBC95\uC774 \uC544\uB2C8\uB77C\uBA74,
    \uD574\uB2F9 \uC870\uD569\uC744 \uC785\uB825\uD574\uB3C4 \uB9C8\uBC95\uC740\n\uB098\uAC00\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uC6E8\uC774\uBE0C\uB9C8\uB2E4 \uC2A4\uD0AC\uC744
    \uAD50\uCCB4\uD560 \uC218 \uC788\uAC8C \uD558\uB824\uACE0 \uD588\uC73C\uB098
    \uAD6C\uD604\uC740 \uC548 \uB410\uC2B5\uB2C8\uB2E4."
  - "\uBAAC\uC2A4\uD130\uB97C \uC8FD\uC774\uBA74, \uAC04\uD639 \uBA54\uBAA8\uB77C\uC774\uC988
    \uC911\uC778 \uB9C8\uBC95\uC758 \uB79C\uB364\uD55C \uB8EC\uC774 \uC18C\uD3ED
    \uAC15\uD654\uB418\uB294 \uC870\uAC01\uC774 \uB4DC\uB78D\uB429\uB2C8\uB2E4.\n\n\uC77C\uBC18
    \uC2A4\uD14C\uC774\uC9C0\uB294 \uD574\uB2F9 \uC6E8\uC774\uBE0C\uC758 \uBAAC\uC2A4\uD130\uB4E4\uC744
    \uB2E4 \uC8FD\uC5EC\uC57C \uB118\uC5B4\uAC00\uBA70,\n\uBCF4\uC2A4\uAC00 \uB098\uC624\uB294
    \uC2A4\uD14C\uC774\uC9C0\uB294 \uBCF4\uC2A4\uB97C \uC8FD\uC5EC\uC57C \uB118\uC5B4\uAC00\uAC8C
    \uB429\uB2C8\uB2E4."
  - "\uAE30\uBCF8 \uB9C8\uB098\uD1B5\uBCF4\uB2E4 \uC18C\uBAA8 \uB9C8\uB098\uB7C9\uC774
    \uB9CE\uC544\uC11C \uBABB \uC4F0\uB294 \uC2A4\uD0AC\uC774 \uC788\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uCD08\uBC18\uC5D0\uB294 \uB9C8\uB098\uD1B5\uC744 \uB298\uB9AC\uC2DC\uB294
    \uAC83\uC744 \uCD94\uCC9C\uB4DC\uB9BD\uB2C8\uB2E4."
